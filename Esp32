void updateTwinNavigationState() {

  long leftDistance;
  long rightDistance;

  readSensors(leftDistance, rightDistance);

  bool navigationActive = autoMode || manualForwardMode;

  if (!navigationActive) {
    twinNavState = "MANUAL";
    twinRerouteSide = "NONE";
    twinRouteInfo = "Waiting for movement command";
    return;
  }

  // Right obstacle -> physical robot reroutes to LEFT.
  if (rightDistance <= OBSTACLE_DISTANCE &&
      leftDistance > OBSTACLE_DISTANCE) {

    twinRerouteSide = "LEFT";

    if (motorStatus == "LEFT") {
      twinNavState = "REROUTING";
      twinRouteInfo = "RIGHT OBSTACLE -> STOP -> LEFT SIDE -> RESUME";
    }
    else {
      twinNavState = "OBSTACLE DETECTED";
      twinRouteInfo = "RIGHT OBSTACLE -> ALTERNATE SIDE: LEFT";
    }

    return;
  }

  // Left obstacle -> physical robot reroutes to RIGHT.
  if (leftDistance <= OBSTACLE_DISTANCE &&
      rightDistance > OBSTACLE_DISTANCE) {

    twinRerouteSide = "RIGHT";

    if (motorStatus == "RIGHT") {
      twinNavState = "REROUTING";
      twinRouteInfo = "LEFT OBSTACLE -> STOP -> RIGHT SIDE -> RESUME";
    }
    else {
      twinNavState = "OBSTACLE DETECTED";
      twinRouteInfo = "LEFT OBSTACLE -> ALTERNATE SIDE: RIGHT";
    }

    return;
  }

  // Both sides blocked -> reverse, then choose the side with more space.
  if (leftDistance <= OBSTACLE_DISTANCE &&
      rightDistance <= OBSTACLE_DISTANCE) {

    twinRerouteSide = "SELECTING";

    if (motorStatus == "BACKWARD") {
      twinNavState = "REROUTING";
      twinRouteInfo = "BOTH BLOCKED -> REVERSE -> SELECT OPEN SIDE";
    }
    else {
      twinNavState = "OBSTACLE DETECTED";
      twinRouteInfo = "BOTH SIDES BLOCKED -> REVERSE + SELECT OPEN SIDE";
    }

    return;
  }

  // No obstacle.
  twinRerouteSide = "NONE";

  if (motorStatus == "FORWARD") {
    twinNavState = "MOVING FORWARD";
    twinRouteInfo = "PATH CLEAR -> FORWARD";
  }
  else if (motorStatus == "LEFT") {
    twinNavState = "TURNING LEFT";
    twinRouteInfo = "LEFT TURN";
  }
  else if (motorStatus == "RIGHT") {
    twinNavState = "TURNING RIGHT";
    twinRouteInfo = "RIGHT TURN";
  }
  else if (motorStatus == "BACKWARD") {
    twinNavState = "REVERSING";
    twinRouteInfo = "REVERSING";
  }
  else {
    twinNavState = "STOPPED";
    twinRouteInfo = "Waiting for movement";
  }
}

void sendTwinTelemetry() {

  if (!mqtt.connected()) {
    return;
  }

  long leftDistance;
  long rightDistance;
  readSensors(leftDistance, rightDistance);

  bool obstacle =
    (leftDistance <= OBSTACLE_DISTANCE ||
     rightDistance <= OBSTACLE_DISTANCE);

  String message = "{";

  message += "\"amr\":\"AMR-01\",";
  message += "\"physical\":true,";
  message += "\"distanceLeft\":" + String(leftDistance) + ",";
  message += "\"distanceRight\":" + String(rightDistance) + ",";
  message += "\"obstacle\":" + String(obstacle ? "true" : "false") + ",";
  message += "\"motor\":\"" + motorStatus + "\",";
  message += "\"autoMode\":" + String(autoMode ? "true" : "false") + ",";
  message += "\"task\":\"" + currentTask + "\",";
  message += "\"navState\":\"" + twinNavState + "\",";
  message += "\"rerouteSide\":\"" + twinRerouteSide + "\",";
  message += "\"routeInfo\":\"" + twinRouteInfo + "\"";

  message += "}";

  mqtt.publish(TELEMETRY_TOPIC.c_str(), message.c_str());

  Serial.print("TWIN TELEMETRY -> ");
  Serial.println(message);
}



// =====================================================
// MOTOR STOP
// =====================================================

void stopMotors() {

  digitalWrite(LEFT_IN1, LOW);
  digitalWrite(LEFT_IN2, LOW);

  digitalWrite(RIGHT_IN1, LOW);
  digitalWrite(RIGHT_IN2, LOW);

  motorStatus = "STOP";

  Serial.println("MOTORS: STOP");
}


// =====================================================
// FORWARD
// =====================================================

void moveForward() {

  digitalWrite(LEFT_IN1, HIGH);
  digitalWrite(LEFT_IN2, LOW);

  digitalWrite(RIGHT_IN1, HIGH);
  digitalWrite(RIGHT_IN2, LOW);

  motorStatus = "FORWARD";

  Serial.println("MOTORS: FORWARD");
}


// =====================================================
// BACKWARD
// =====================================================

void moveBackward() {

  digitalWrite(LEFT_IN1, LOW);
  digitalWrite(LEFT_IN2, HIGH);

  digitalWrite(RIGHT_IN1, LOW);
  digitalWrite(RIGHT_IN2, HIGH);

  motorStatus = "BACKWARD";

  Serial.println("MOTORS: BACKWARD");
}


// =====================================================
// LEFT
// =====================================================

void turnLeft() {

  digitalWrite(LEFT_IN1, LOW);
  digitalWrite(LEFT_IN2, HIGH);

  digitalWrite(RIGHT_IN1, HIGH);
  digitalWrite(RIGHT_IN2, LOW);

  motorStatus = "LEFT";

  Serial.println("MOTORS: LEFT");
}


// =====================================================
// RIGHT
// =====================================================

void turnRight() {

  digitalWrite(LEFT_IN1, HIGH);
  digitalWrite(LEFT_IN2, LOW);

  digitalWrite(RIGHT_IN1, LOW);
  digitalWrite(RIGHT_IN2, HIGH);

  motorStatus = "RIGHT";

  Serial.println("MOTORS: RIGHT");
}


// =====================================================
// ULTRASONIC DISTANCE
// =====================================================

long getDistance(int trigPin, int echoPin) {

  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);

  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);

  digitalWrite(trigPin, LOW);

  long duration = pulseIn(echoPin, HIGH, 30000);

  if (duration == 0) {
    return 999;
  }

  long distance = duration * 0.0343 / 2;

  return distance;
}


// =====================================================
// READ BOTH SENSORS
// =====================================================

void readSensors(long &leftDistance, long &rightDistance) {

  // SENSOR 1 = RIGHT
  rightDistance = getDistance(TRIG1, ECHO1);

  delay(5);

  // SENSOR 2 = LEFT
  leftDistance = getDistance(TRIG2, ECHO2);
}


